<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>zeka-owner-sql-probe</AssemblyName>
    <ZekaSourceSha Condition="'$(ZekaSourceSha)' == ''">unknown</ZekaSourceSha>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <AssemblyMetadata Include="SourceCommit" Value="$(ZekaSourceSha)" />
    <Compile Include="../Shared/SafePostgresDiagnostics.cs" Link="SafePostgresDiagnostics.cs" />
    <Compile Include="../Shared/OwnerSqlExecution.cs" Link="OwnerSqlExecution.cs" />
  </ItemGroup>
</Project>
